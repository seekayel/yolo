{
  "name": "YOLO Devcontainer",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "onceler",
  "workspaceFolder": "/home/onceler/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/onceler/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "runArgs": [
    "--hostname",
    "yolo-os"
  ],
  "postStartCommand": "hostname yolo-os 2>/dev/null || true; if command -v direnv >/dev/null 2>&1; then direnv allow /home/onceler/${localWorkspaceFolderBasename}; fi",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/onceler/.claude,type=bind",
    "source=${localEnv:HOME}/.codex,target=/home/onceler/.codex,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/onceler/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/onceler/.gitconfig,type=bind,consistency=cached,ro"
  ],
  "containerEnv": {
    "HOSTNAME": "yolo-os",
    "WARP_API_KEY": "${localEnv:WARP_API_KEY}",
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
  }
}
